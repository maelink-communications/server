SYSTEM_MESSAGE=               # optional - sent to a new user's inbox upon registering
PORT=7000                     # port this server listens on (HTTP)
WS_PORT=7001                  # port this server listens on (WEBSOCKET)
SERVER_NAME=                  # name of this server - shows up on the server's sample page
SERVER_DESCRIPTION=           # description for this server - shows up on the server's sample page
LOG_LEVEL=                    # log level - accepted values: "trace", "error" - default is "error"
EXPOSE_ERROR_STACK=false      # include exact server stack traces in API error responses (development only)
MASTER_CODE_FILE=.master-code # persistent master login code file; keep this secret and out of version control
UPLOADS_ENABLED=false         # start the optional uploads server
UPLOADS_ONLY=false            # run only the uploads listener; do not start the normal HTTP or WebSocket servers
UPLOADS_PORT=7002             # port used by the uploads server
UPLOADS_DIR=uploads           # directory used to store uploaded files
UPLOADS_EXPIRY_DAYS=0         # delete uploads after this many days; supports decimals such as 0.5, and 0 disables expiry
UPLOADS_PUBLIC_URL=           # public uploads origin, e.g. https://uploads.example.com (defaults to localhost:UPLOADS_PORT)
UPLOADS_UPSTREAM_URL=         # normal-server-only internal URL of an uploads-only server, e.g. http://uploads:7002
UPLOADS_INTERNAL_SECRET=      # shared secret used between normal and uploads-only servers; use the same long random value on both
