SYSTEM_MESSAGE=    # optional - sent to new users on register

# Sync / P2P replication (all optional)
SERVER_ID=         # unique ID for this node (auto-generated UUID if unset) - this is encouraged to be set
SERVER_ADDRESS=    # public hostname/IP of this node (default: localhost)
PORT=7000          # port this node listens on
REGISTRY_URL=      # URL of the registry service (default: http://localhost:8000)